# Public site URL
NEXT_PUBLIC_SITE_URL=https://wtech.md

# Supabase server credentials (never use NEXT_PUBLIC_ for the service role key)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Admin
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Vercel/proxy behavior
TRUST_PROXY=1
RATE_LIMIT_MAX=8
ALLOWED_ORIGINS=https://wtech.md,https://www.wtech.md

# Optional lead notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
LEADS_TO=

# Optional direct Anthropic connection. On Vercel, AI Gateway uses the automatically injected VERCEL_OIDC_TOKEN.
ANTHROPIC_API_KEY=
CHAT_DISABLED=0

# Optional public contact fallbacks; /admin settings override these
NEXT_PUBLIC_PHONE=
NEXT_PUBLIC_WHATSAPP=
NEXT_PUBLIC_TELEGRAM=
NEXT_PUBLIC_VIBER=
NEXT_PUBLIC_EMAIL=hello@wtech.md
NEXT_PUBLIC_ADDRESS=
NEXT_PUBLIC_IDNO=
NEXT_PUBLIC_FACEBOOK=
NEXT_PUBLIC_INSTAGRAM=
NEXT_PUBLIC_LINKEDIN=
NEXT_PUBLIC_CAL_URL=

# Optional analytics
NEXT_PUBLIC_UMAMI_URL=
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
